# LLM (Groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Mem0 (Optional - if blank, uses local mode)
MEM0_API_KEY=
MEM0_COLLECTION=rag_memory
MEM0_USER_ID=default_user

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_docs

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_DOCS=5
TOP_K_MEMORY=3
